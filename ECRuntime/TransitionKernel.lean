import ECRuntime.FiniteTrajectoryConsistency
import Mathlib.Probability.Kernel.IonescuTulcea.Traj
import Mathlib.Probability.ProbabilityMassFunction.Constructions
import Mathlib

open scoped BigOperators ENNReal
open MeasureTheory ProbabilityTheory

namespace ECRuntime

/-!
# Stage 17: discrete Markov-kernel adapter and infinite trajectories

The core runtime development uses real-valued finite transition matrices.  Mathlib's
Ionescu--Tulcea construction is phrased in terms of measure-theoretic Markov kernels.
This file supplies the finite-state adapter and instantiates the existing infinite
trajectory kernel without changing the earlier Bellman or finite-path semantics.
-/

/-- The probability mass function associated with one stochastic row of a finite
real-valued transition matrix. -/
noncomputable def transitionPMF {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (x : α) : PMF α :=
  PMF.ofFintype (fun y => ENNReal.ofReal (P x y)) (by
    have hnonneg : ∀ y ∈ (Finset.univ : Finset α), 0 ≤ P x y := by
      intro y _hy
      exact hP.1 x y
    calc
      (∑ y : α, ENNReal.ofReal (P x y)) =
          ENNReal.ofReal (∑ y : α, P x y) := by
            symm
            exact ENNReal.ofReal_sum_of_nonneg hnonneg
      _ = 1 := by simp [hP.2 x])

@[simp] theorem transitionPMF_apply {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (x y : α) :
    transitionPMF P hP x y = ENNReal.ofReal (P x y) := by
  rfl

/-- Measure-theoretic Markov kernel associated with a finite stochastic transition
matrix.  The measurable structure is allowed to be any one with measurable singletons;
on a finite type this is enough for arbitrary row-to-measure maps to be measurable. -/
noncomputable def transitionKernel {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) : Kernel α α :=
  Kernel.ofFunOfCountable (fun x => (transitionPMF P hP x).toMeasure)

@[simp] theorem transitionKernel_apply {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (x : α) :
    transitionKernel P hP x = (transitionPMF P hP x).toMeasure := by
  rfl

instance instIsMarkovKernelTransitionKernel {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) :
    IsMarkovKernel (transitionKernel P hP) :=
  ⟨fun x => by
    change IsProbabilityMeasure ((transitionPMF P hP x).toMeasure)
    infer_instance⟩

/-- Singleton probabilities of the kernel recover the original real transition
probabilities after embedding into `ENNReal`. -/
@[simp] theorem transitionKernel_singleton {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (x y : α) :
    transitionKernel P hP x {y} = ENNReal.ofReal (P x y) := by
  rw [transitionKernel_apply]
  rw [PMF.toMeasure_apply_singleton _ y (measurableSet_singleton y)]
  exact transitionPMF_apply P hP x y

/-- The last state in a finite history indexed by `Finset.Iic n`. -/
def transitionHistoryLast {α : Type*} (n : ℕ)
    (hist : (i : Finset.Iic n) → α) : α :=
  hist ⟨n, Finset.mem_Iic.mpr le_rfl⟩

/-- History-dependent kernel required by `Kernel.traj`: the law of the next state
is the transition row of the final state in the supplied history. -/
noncomputable def transitionHistoryKernel {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (n : ℕ) :
    Kernel ((i : Finset.Iic n) → α) α :=
  Kernel.ofFunOfCountable
    (fun hist => (transitionPMF P hP (transitionHistoryLast n hist)).toMeasure)

@[simp] theorem transitionHistoryKernel_apply {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (n : ℕ)
    (hist : (i : Finset.Iic n) → α) :
    transitionHistoryKernel P hP n hist =
      (transitionPMF P hP (transitionHistoryLast n hist)).toMeasure := by
  rfl

instance instIsMarkovKernelTransitionHistoryKernel {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (n : ℕ) :
    IsMarkovKernel (transitionHistoryKernel P hP n) :=
  ⟨fun hist => by
    change IsProbabilityMeasure
      ((transitionPMF P hP (transitionHistoryLast n hist)).toMeasure)
    infer_instance⟩

/-- The infinite trajectory kernel generated by the finite transition matrix, using
Mathlib's Ionescu--Tulcea construction.  An input is a history through time zero;
the output is a probability law on complete trajectories `ℕ → α`. -/
noncomputable def transitionTrajectoryKernel {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) :
    Kernel ((i : Finset.Iic 0) → α) (ℕ → α) :=
  Kernel.traj (X := fun _ : ℕ => α)
    (fun n => transitionHistoryKernel P hP n) 0

instance instIsMarkovKernelTransitionTrajectoryKernel {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) :
    IsMarkovKernel (transitionTrajectoryKernel P hP) := by
  unfold transitionTrajectoryKernel
  infer_instance

/-- The first random coordinate of the infinite trajectory has exactly the
history-dependent transition kernel at time zero. -/
theorem transitionTrajectoryKernel_map_next {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) :
    (transitionTrajectoryKernel P hP).map (fun path : ℕ → α => path 1) =
      transitionHistoryKernel P hP 0 := by
  unfold transitionTrajectoryKernel
  simpa using
    (Kernel.map_traj_succ_self
      (X := fun _ : ℕ => α)
      (κ := fun n => transitionHistoryKernel P hP n)
      (a := 0))

/-- Canonical history through time zero corresponding to a fixed initial state. -/
def transitionInitialHistory {α : Type*} (x : α) : (i : Finset.Iic 0) → α :=
  fun _ => x

@[simp] theorem transitionHistoryLast_initial {α : Type*} (x : α) :
    transitionHistoryLast 0 (transitionInitialHistory x) = x := by
  rfl

/-- The infinite trajectory measure started from a deterministic initial state. -/
noncomputable def transitionTrajectoryMeasure {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (x : α) : Measure (ℕ → α) :=
  transitionTrajectoryKernel P hP (transitionInitialHistory x)

instance instIsProbabilityMeasureTransitionTrajectoryMeasure {α : Type*} [Fintype α]
    [MeasurableSpace α] [MeasurableSingletonClass α]
    (P : TransitionMatrix α) (hP : IsStochastic P) (x : α) :
    IsProbabilityMeasure (transitionTrajectoryMeasure P hP x) := by
  unfold transitionTrajectoryMeasure
  infer_instance

end ECRuntime
