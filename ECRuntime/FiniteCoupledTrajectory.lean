import ECRuntime.ExitBernoulliSplit
import ECRuntime.FiniteTrajectoryConsistency
import Mathlib

open scoped BigOperators ENNReal

namespace ECRuntime

/-!
# Stage 26 fix 25: finite coupled trajectory laws

The verified one-step exit/Bernoulli split has two history-uniform marginals: summing
out the comparison label recovers the original transition row, while summing out the
next state gives the same Bernoulli comparison row at every current state in the
active level.  The final adaptive construction needs this statement not only for one
step but for finite prefixes.

This file isolates the corresponding finite-dimensional algebra.  For a generic
labelled transition weight `J x y b`, it defines a recursive finite trajectory weight
on pairs `(next state, label)` and proves:

* if the state marginal of every labelled row is `P x y`, then summing over every
  finite label path gives the ordinary `finiteTrajectoryWeight P` of the state path;
* if the label marginal of every labelled row is a fixed weight `q b`, independent of
  the current state, then summing over every finite state path gives the recursive
  i.i.d. label-path weight generated by `q`;
* nonnegative normalized labelled rows therefore produce nonnegative unit-mass finite
  coupled path laws.

The second half specializes this interface to the Stage-26 exit/Bernoulli split.  When
the current state lies in the chosen level we use the verified split; outside the
level we tensor the original transition row with an independent Bernoulli label.  The
extension is only a bookkeeping device: it makes both marginals valid on every current
state, which lets the finite-prefix induction proceed without a side condition saying
that the trajectory is still in the level.

The result is the finite-dimensional precursor of the final sequential coupling.  A
later module can change the active level after a first comparison success / real exit,
iterate these finite laws, and pass to the already verified product-coupling bridge.
-/

/-- Zip a finite state trajectory and a finite label trajectory coordinatewise. -/
def zipFiniteTrajectories {α β : Type*} {t : ℕ}
    (states : FiniteTrajectory α t) (labels : FiniteTrajectory β t) :
    FiniteTrajectory (α × β) t :=
  fun i => (states i, labels i)

@[simp] theorem zipFiniteTrajectories_cons
    {α β : Type*} {t : ℕ}
    (y : α) (b : β)
    (states : FiniteTrajectory α t) (labels : FiniteTrajectory β t) :
    zipFiniteTrajectories (Fin.cons y states) (Fin.cons b labels) =
      Fin.cons (y, b) (zipFiniteTrajectories states labels) := by
  funext i
  refine Fin.cases ?_ (fun j => ?_) i
  · rfl
  · rfl

/-- Recursive weight of a finite trajectory whose every transition emits a label. -/
def finiteLabeledTrajectoryWeight {α β : Type*}
    (J : α → α → β → ℝ) :
    (t : ℕ) → α → FiniteTrajectory (α × β) t → ℝ
  | 0, _x, _path => 1
  | t + 1, x, path =>
      J x (path 0).1 (path 0).2 *
        finiteLabeledTrajectoryWeight J t (path 0).1 (Fin.tail path)

@[simp] theorem finiteLabeledTrajectoryWeight_cons
    {α β : Type*}
    (J : α → α → β → ℝ) (t : ℕ) (x y : α) (b : β)
    (tail : FiniteTrajectory (α × β) t) :
    finiteLabeledTrajectoryWeight J (t + 1) x (Fin.cons (y, b) tail) =
      J x y b * finiteLabeledTrajectoryWeight J t y tail := by
  simp [finiteLabeledTrajectoryWeight]

@[simp] theorem finiteLabeledTrajectoryWeight_cons_pair
    {α β : Type*}
    (J : α → α → β → ℝ) (t : ℕ) (x : α) (z : α × β)
    (tail : FiniteTrajectory (α × β) t) :
    finiteLabeledTrajectoryWeight J (t + 1) x (Fin.cons z tail) =
      J x z.1 z.2 * finiteLabeledTrajectoryWeight J t z.1 tail := by
  rcases z with ⟨y, b⟩
  exact finiteLabeledTrajectoryWeight_cons J t x y b tail

@[simp] theorem finiteLabeledTrajectoryWeight_zip_cons
    {α β : Type*}
    (J : α → α → β → ℝ) (t : ℕ) (x y : α) (b : β)
    (states : FiniteTrajectory α t) (labels : FiniteTrajectory β t) :
    finiteLabeledTrajectoryWeight J (t + 1) x
        (zipFiniteTrajectories (Fin.cons y states) (Fin.cons b labels)) =
      J x y b *
        finiteLabeledTrajectoryWeight J t y
          (zipFiniteTrajectories states labels) := by
  rw [zipFiniteTrajectories_cons]
  exact finiteLabeledTrajectoryWeight_cons J t x y b
    (zipFiniteTrajectories states labels)

/-- Recursive weight of a finite i.i.d. label path with one-step weight `q`. -/
def finiteIIDLabelWeight {β : Type*} (q : β → ℝ) :
    (t : ℕ) → FiniteTrajectory β t → ℝ
  | 0, _path => 1
  | t + 1, path => q (path 0) * finiteIIDLabelWeight q t (Fin.tail path)

@[simp] theorem finiteIIDLabelWeight_cons
    {β : Type*} (q : β → ℝ) (t : ℕ) (b : β)
    (tail : FiniteTrajectory β t) :
    finiteIIDLabelWeight q (t + 1) (Fin.cons b tail) =
      q b * finiteIIDLabelWeight q t tail := by
  simp [finiteIIDLabelWeight]

/-- Exact finite state-path marginal of a history-uniform labelled transition law. -/
theorem finiteLabeledTrajectoryWeight_state_marginal
    {α β : Type*} [Fintype β]
    (J : α → α → β → ℝ) (P : TransitionMatrix α)
    (hstate : ∀ x y, (∑ b : β, J x y b) = P x y) :
    ∀ t (x : α) (states : FiniteTrajectory α t),
      (∑ labels : FiniteTrajectory β t,
        finiteLabeledTrajectoryWeight J t x
          (zipFiniteTrajectories states labels)) =
        finiteTrajectoryWeight P t x states := by
  intro t
  induction t with
  | zero =>
      intro x states
      simp [finiteLabeledTrajectoryWeight, finiteTrajectoryWeight]
  | succ t ih =>
      intro x states
      let y : α := states 0
      let stateTail : FiniteTrajectory α t := Fin.tail states
      have hstates : states = Fin.cons y stateTail := by
        exact (Fin.cons_self_tail states).symm
      rw [hstates]
      rw [sum_finiteTrajectory_succ (α := β) t]
      simp_rw [finiteLabeledTrajectoryWeight_zip_cons]
      calc
        (∑ b : β, ∑ labelTail : FiniteTrajectory β t,
            J x y b *
              finiteLabeledTrajectoryWeight J t y
                (zipFiniteTrajectories stateTail labelTail)) =
            ∑ b : β, J x y b *
              finiteTrajectoryWeight P t y stateTail := by
          apply Finset.sum_congr rfl
          intro b _hb
          calc
            (∑ labelTail : FiniteTrajectory β t,
                J x y b *
                  finiteLabeledTrajectoryWeight J t y
                    (zipFiniteTrajectories stateTail labelTail)) =
                J x y b *
                  (∑ labelTail : FiniteTrajectory β t,
                    finiteLabeledTrajectoryWeight J t y
                      (zipFiniteTrajectories stateTail labelTail)) := by
              rw [Finset.mul_sum]
            _ = J x y b * finiteTrajectoryWeight P t y stateTail := by
              rw [ih y stateTail]
        _ = (∑ b : β, J x y b) *
              finiteTrajectoryWeight P t y stateTail := by
          rw [Finset.sum_mul]
        _ = P x y * finiteTrajectoryWeight P t y stateTail := by
          rw [hstate x y]
        _ = finiteTrajectoryWeight P (t + 1) x (Fin.cons y stateTail) := by
          rfl

/-- Exact finite label-path marginal when the one-step label marginal is independent
of the current state.  This is the finite-dimensional independence theorem used by
the Bernoulli comparison construction. -/
theorem finiteLabeledTrajectoryWeight_label_marginal
    {α β : Type*} [Fintype α]
    (J : α → α → β → ℝ) (q : β → ℝ)
    (hlabel : ∀ x b, (∑ y : α, J x y b) = q b) :
    ∀ t (x : α) (labels : FiniteTrajectory β t),
      (∑ states : FiniteTrajectory α t,
        finiteLabeledTrajectoryWeight J t x
          (zipFiniteTrajectories states labels)) =
        finiteIIDLabelWeight q t labels := by
  intro t
  induction t with
  | zero =>
      intro x labels
      simp [finiteLabeledTrajectoryWeight, finiteIIDLabelWeight]
  | succ t ih =>
      intro x labels
      let b : β := labels 0
      let labelTail : FiniteTrajectory β t := Fin.tail labels
      have hlabels : labels = Fin.cons b labelTail := by
        exact (Fin.cons_self_tail labels).symm
      rw [hlabels]
      rw [sum_finiteTrajectory_succ (α := α) t]
      simp_rw [finiteLabeledTrajectoryWeight_zip_cons]
      calc
        (∑ y : α, ∑ stateTail : FiniteTrajectory α t,
            J x y b *
              finiteLabeledTrajectoryWeight J t y
                (zipFiniteTrajectories stateTail labelTail)) =
            ∑ y : α, J x y b * finiteIIDLabelWeight q t labelTail := by
          apply Finset.sum_congr rfl
          intro y _hy
          calc
            (∑ stateTail : FiniteTrajectory α t,
                J x y b *
                  finiteLabeledTrajectoryWeight J t y
                    (zipFiniteTrajectories stateTail labelTail)) =
                J x y b *
                  (∑ stateTail : FiniteTrajectory α t,
                    finiteLabeledTrajectoryWeight J t y
                      (zipFiniteTrajectories stateTail labelTail)) := by
              rw [Finset.mul_sum]
            _ = J x y b * finiteIIDLabelWeight q t labelTail := by
              rw [ih y labelTail]
        _ = (∑ y : α, J x y b) * finiteIIDLabelWeight q t labelTail := by
          rw [Finset.sum_mul]
        _ = q b * finiteIIDLabelWeight q t labelTail := by
          rw [hlabel x b]
        _ = finiteIIDLabelWeight q (t + 1) (Fin.cons b labelTail) := by
          rfl

/-- Nonnegative labelled rows generate nonnegative finite labelled path weights. -/
theorem finiteLabeledTrajectoryWeight_nonneg
    {α β : Type*} (J : α → α → β → ℝ)
    (hJ : ∀ x y b, 0 ≤ J x y b) :
    ∀ t (x : α) (path : FiniteTrajectory (α × β) t),
      0 ≤ finiteLabeledTrajectoryWeight J t x path := by
  intro t
  induction t with
  | zero =>
      intro x path
      simp [finiteLabeledTrajectoryWeight]
  | succ t ih =>
      intro x path
      exact mul_nonneg
        (hJ x (path 0).1 (path 0).2)
        (ih (path 0).1 (Fin.tail path))

/-- Unit-mass labelled rows generate unit-mass finite labelled path weights. -/
theorem finiteLabeledTrajectoryWeight_sum
    {α β : Type*} [Fintype α] [Fintype β]
    (J : α → α → β → ℝ)
    (hrow : ∀ x, (∑ y : α, ∑ b : β, J x y b) = 1) :
    ∀ t (x : α),
      (∑ path : FiniteTrajectory (α × β) t,
        finiteLabeledTrajectoryWeight J t x path) = 1 := by
  intro t
  induction t with
  | zero =>
      intro x
      simp [finiteLabeledTrajectoryWeight]
  | succ t ih =>
      intro x
      rw [sum_finiteTrajectory_succ (α := α × β) t]
      simp_rw [finiteLabeledTrajectoryWeight_cons_pair]
      calc
        (∑ z : α × β, ∑ tail : FiniteTrajectory (α × β) t,
            J x z.1 z.2 * finiteLabeledTrajectoryWeight J t z.1 tail) =
            ∑ z : α × β, J x z.1 z.2 := by
          apply Finset.sum_congr rfl
          intro z _hz
          calc
            (∑ tail : FiniteTrajectory (α × β) t,
                J x z.1 z.2 * finiteLabeledTrajectoryWeight J t z.1 tail) =
                J x z.1 z.2 *
                  (∑ tail : FiniteTrajectory (α × β) t,
                    finiteLabeledTrajectoryWeight J t z.1 tail) := by
              rw [Finset.mul_sum]
            _ = J x z.1 z.2 := by rw [ih z.1]; ring
        _ = ∑ y : α, ∑ b : β, J x y b := by
          simpa using
            (Fintype.sum_prod_type
              (fun z : α × β => J x z.1 z.2))
        _ = 1 := hrow x

/-- The two exact marginal identities imply normalization whenever the state marginal
is a stochastic transition matrix. -/
theorem finiteLabeledTrajectoryWeight_sum_of_state_marginal
    {α β : Type*} [Fintype α] [Fintype β]
    (J : α → α → β → ℝ) (P : TransitionMatrix α)
    (hP : IsStochastic P)
    (hstate : ∀ x y, (∑ b : β, J x y b) = P x y) :
    ∀ t (x : α),
      (∑ path : FiniteTrajectory (α × β) t,
        finiteLabeledTrajectoryWeight J t x path) = 1 := by
  apply finiteLabeledTrajectoryWeight_sum J
  intro x
  calc
    (∑ y : α, ∑ b : β, J x y b) = ∑ y : α, P x y := by
      apply Finset.sum_congr rfl
      intro y _hy
      exact hstate x y
    _ = 1 := hP.2 x

/-- Bernoulli weights are nonnegative for parameters in `[0,1]`. -/
theorem bernoulliBoolWeight_nonneg
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (b : Bool) :
    0 ≤ bernoulliBoolWeight p b := by
  cases b with
  | false =>
      simp [bernoulliBoolWeight]
      linarith
  | true =>
      simpa [bernoulliBoolWeight] using hp0

/-- Bernoulli weights have total mass one. -/
theorem sum_bernoulliBoolWeight (p : ℝ) :
    (∑ b : Bool, bernoulliBoolWeight p b) = 1 := by
  simp [bernoulliBoolWeight]

/-- Extend the verified level-exit split to all current states.  Inside `level` this is
the Stage-26 split.  Outside `level` the real transition and comparison label are
independent; this branch is used only to obtain a globally defined finite-prefix law. -/
noncomputable def levelBernoulliCoupledStepWeight
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (x y : α) (b : Bool) : ℝ := by
  classical
  exact if x ∈ level then
    transitionLevelExitBernoulliSplitWeight P level p x y b
  else
    P x y * bernoulliBoolWeight p b

@[simp] theorem levelBernoulliCoupledStepWeight_of_mem
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (x y : α) (b : Bool) (hx : x ∈ level) :
    levelBernoulliCoupledStepWeight P level p x y b =
      transitionLevelExitBernoulliSplitWeight P level p x y b := by
  classical
  simp [levelBernoulliCoupledStepWeight, hx]

@[simp] theorem levelBernoulliCoupledStepWeight_of_not_mem
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (x y : α) (b : Bool) (hx : x ∉ level) :
    levelBernoulliCoupledStepWeight P level p x y b =
      P x y * bernoulliBoolWeight p b := by
  classical
  simp [levelBernoulliCoupledStepWeight, hx]

/-- Summing out the comparison label always recovers the original transition row. -/
theorem levelBernoulliCoupledStepWeight_state_marginal
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (x y : α) :
    (∑ b : Bool, levelBernoulliCoupledStepWeight P level p x y b) = P x y := by
  classical
  by_cases hx : x ∈ level
  · calc
      (∑ b : Bool, levelBernoulliCoupledStepWeight P level p x y b) =
          ∑ b : Bool, transitionLevelExitBernoulliSplitWeight P level p x y b := by
        apply Finset.sum_congr rfl
        intro b _hb
        rw [levelBernoulliCoupledStepWeight_of_mem P level p x y b hx]
      _ = P x y := by
        simpa [add_comm] using
          (transitionLevelExitBernoulliSplit_state_marginal P level p x y)
  · calc
      (∑ b : Bool, levelBernoulliCoupledStepWeight P level p x y b) =
          ∑ b : Bool, P x y * bernoulliBoolWeight p b := by
        apply Finset.sum_congr rfl
        intro b _hb
        rw [levelBernoulliCoupledStepWeight_of_not_mem P level p x y b hx]
      _ = P x y * (∑ b : Bool, bernoulliBoolWeight p b) := by
        rw [Finset.mul_sum]
      _ = P x y := by rw [sum_bernoulliBoolWeight]; ring

/-- Summing out the next state always gives the same Bernoulli-`p` label marginal.
Inside the level this is the substantive verified split theorem; outside the level it
is the independent-product extension. -/
theorem levelBernoulliCoupledStepWeight_label_marginal
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α)
    (hP : IsStochastic P) (p : ℝ) (hp : 0 < p)
    (hexit : ∀ z, z ∈ level →
      p ≤ finiteEventMass (P z) (fun y => y ∉ level))
    (x : α) (b : Bool) :
    (∑ y : α, levelBernoulliCoupledStepWeight P level p x y b) =
      bernoulliBoolWeight p b := by
  classical
  by_cases hx : x ∈ level
  · calc
      (∑ y : α, levelBernoulliCoupledStepWeight P level p x y b) =
          ∑ y : α, transitionLevelExitBernoulliSplitWeight P level p x y b := by
        apply Finset.sum_congr rfl
        intro y _hy
        rw [levelBernoulliCoupledStepWeight_of_mem P level p x y b hx]
      _ = bernoulliBoolWeight p b :=
        transitionLevelExitBernoulliSplit_comparison_marginal
          P level hP p hp hexit x hx b
  · calc
      (∑ y : α, levelBernoulliCoupledStepWeight P level p x y b) =
          ∑ y : α, P x y * bernoulliBoolWeight p b := by
        apply Finset.sum_congr rfl
        intro y _hy
        rw [levelBernoulliCoupledStepWeight_of_not_mem P level p x y b hx]
      _ = (∑ y : α, P x y) * bernoulliBoolWeight p b := by
        rw [Finset.sum_mul]
      _ = bernoulliBoolWeight p b := by rw [hP.2 x]; ring

/-- While the current state is in the active level, positive mass on a `true`
comparison label can occur only on a genuine real exit. -/
theorem levelBernoulliCoupledStepWeight_success_forces_exit_of_mem
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (x y : α) (hx : x ∈ level)
    (hpositive : 0 < levelBernoulliCoupledStepWeight P level p x y true) :
    y ∉ level := by
  rw [levelBernoulliCoupledStepWeight_of_mem P level p x y true hx] at hpositive
  exact transitionLevelExitBernoulliSplit_success_forces_exit
    P level p x y hpositive

/-- Under the usual stochasticity and exit-bound assumptions, every extended coupled
step weight is nonnegative. -/
theorem levelBernoulliCoupledStepWeight_nonneg
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α)
    (hP : IsStochastic P) (p : ℝ) (hp : 0 < p) (hp1 : p ≤ 1)
    (hexit : ∀ z, z ∈ level →
      p ≤ finiteEventMass (P z) (fun y => y ∉ level))
    (x y : α) (b : Bool) :
    0 ≤ levelBernoulliCoupledStepWeight P level p x y b := by
  classical
  by_cases hx : x ∈ level
  · rw [levelBernoulliCoupledStepWeight_of_mem P level p x y b hx]
    exact transitionLevelExitBernoulliSplit_nonneg
      P level hP p hp hexit x hx y b
  · rw [levelBernoulliCoupledStepWeight_of_not_mem P level p x y b hx]
    exact mul_nonneg (hP.1 x y)
      (bernoulliBoolWeight_nonneg (le_of_lt hp) hp1 b)

/-- Finite coupled trajectory weight obtained from the globally extended fixed-level
Bernoulli split. -/
noncomputable def finiteLevelBernoulliCoupledWeight
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (t : ℕ) (x : α) (path : FiniteTrajectory (α × Bool) t) : ℝ :=
  finiteLabeledTrajectoryWeight
    (levelBernoulliCoupledStepWeight P level p) t x path

/-- The finite state-path marginal of the fixed-level coupling is exactly the original
finite Markov trajectory weight. -/
theorem finiteLevelBernoulliCoupledWeight_state_marginal
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α) (p : ℝ)
    (t : ℕ) (x : α) (states : FiniteTrajectory α t) :
    (∑ labels : FiniteTrajectory Bool t,
      finiteLevelBernoulliCoupledWeight P level p t x
        (zipFiniteTrajectories states labels)) =
      finiteTrajectoryWeight P t x states := by
  unfold finiteLevelBernoulliCoupledWeight
  exact finiteLabeledTrajectoryWeight_state_marginal
    (levelBernoulliCoupledStepWeight P level p) P
    (levelBernoulliCoupledStepWeight_state_marginal P level p)
    t x states

/-- The finite comparison-label marginal is exactly the recursive i.i.d. Bernoulli
path law, despite the real state trajectory being adaptive. -/
theorem finiteLevelBernoulliCoupledWeight_label_marginal
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α)
    (hP : IsStochastic P) (p : ℝ) (hp : 0 < p)
    (hexit : ∀ z, z ∈ level →
      p ≤ finiteEventMass (P z) (fun y => y ∉ level))
    (t : ℕ) (x : α) (labels : FiniteTrajectory Bool t) :
    (∑ states : FiniteTrajectory α t,
      finiteLevelBernoulliCoupledWeight P level p t x
        (zipFiniteTrajectories states labels)) =
      finiteIIDLabelWeight (bernoulliBoolWeight p) t labels := by
  unfold finiteLevelBernoulliCoupledWeight
  exact finiteLabeledTrajectoryWeight_label_marginal
    (levelBernoulliCoupledStepWeight P level p)
    (bernoulliBoolWeight p)
    (levelBernoulliCoupledStepWeight_label_marginal P level hP p hp hexit)
    t x labels

/-- The specialized finite coupled path weights are nonnegative. -/
theorem finiteLevelBernoulliCoupledWeight_nonneg
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α)
    (hP : IsStochastic P) (p : ℝ) (hp : 0 < p) (hp1 : p ≤ 1)
    (hexit : ∀ z, z ∈ level →
      p ≤ finiteEventMass (P z) (fun y => y ∉ level))
    (t : ℕ) (x : α) (path : FiniteTrajectory (α × Bool) t) :
    0 ≤ finiteLevelBernoulliCoupledWeight P level p t x path := by
  unfold finiteLevelBernoulliCoupledWeight
  exact finiteLabeledTrajectoryWeight_nonneg
    (levelBernoulliCoupledStepWeight P level p)
    (levelBernoulliCoupledStepWeight_nonneg P level hP p hp hp1 hexit)
    t x path

/-- The specialized finite coupled path weights have total mass one. -/
theorem finiteLevelBernoulliCoupledWeight_sum
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α)
    (hP : IsStochastic P) (p : ℝ)
    (t : ℕ) (x : α) :
    (∑ path : FiniteTrajectory (α × Bool) t,
      finiteLevelBernoulliCoupledWeight P level p t x path) = 1 := by
  unfold finiteLevelBernoulliCoupledWeight
  exact finiteLabeledTrajectoryWeight_sum_of_state_marginal
    (levelBernoulliCoupledStepWeight P level p) P hP
    (levelBernoulliCoupledStepWeight_state_marginal P level p)
    t x

/-- The finite coupled weights packaged as a probability mass function.  This is the
measure-ready object that the next sequential stage can compose across active levels. -/
noncomputable def finiteLevelBernoulliCoupledPMF
    {α : Type*} [Fintype α]
    (P : TransitionMatrix α) (level : Set α)
    (hP : IsStochastic P) (p : ℝ) (hp : 0 < p) (hp1 : p ≤ 1)
    (hexit : ∀ z, z ∈ level →
      p ≤ finiteEventMass (P z) (fun y => y ∉ level))
    (t : ℕ) (x : α) : PMF (FiniteTrajectory (α × Bool) t) :=
  PMF.ofFintype
    (fun path => ENNReal.ofReal
      (finiteLevelBernoulliCoupledWeight P level p t x path))
    (by
      have hnonneg :
          ∀ path ∈ (Finset.univ : Finset (FiniteTrajectory (α × Bool) t)),
            0 ≤ finiteLevelBernoulliCoupledWeight P level p t x path := by
        intro path _hpath
        exact finiteLevelBernoulliCoupledWeight_nonneg
          P level hP p hp hp1 hexit t x path
      calc
        (∑ path : FiniteTrajectory (α × Bool) t,
            ENNReal.ofReal
              (finiteLevelBernoulliCoupledWeight P level p t x path)) =
            ENNReal.ofReal
              (∑ path : FiniteTrajectory (α × Bool) t,
                finiteLevelBernoulliCoupledWeight P level p t x path) := by
          symm
          exact ENNReal.ofReal_sum_of_nonneg hnonneg
        _ = 1 := by
          rw [finiteLevelBernoulliCoupledWeight_sum P level hP p t x]
          simp)

end ECRuntime
