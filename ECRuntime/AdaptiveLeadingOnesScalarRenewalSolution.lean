import Mathlib

namespace ECRuntime

/-!
Stage 274 (P01, new research proposal).
An exact scalar uniqueness lemma for a discrete occupation renewal relation.
This is finite-horizon algebra; it does not assert the countable
occupation/expected-runtime bridge of Stage 245.
-/

/-- Finite-horizon occupation mass generated by an initial mass, a
nonnegative-or-signed entry stream, and a same-level stay coefficient. -/
def finiteOccupationRenewalSolution (q initial : Real) (entry : Nat → Real) : Nat → Real
  | 0 => initial
  | t + 1 => entry t + q * finiteOccupationRenewalSolution q initial entry t

/-- Any scalar sequence satisfying an exact one-step renewal equation
is the recursively generated occupation sequence. No probabilistic
assumption is needed for this uniqueness theorem. -/
theorem proposed_finiteOccupationRenewalSolution_unique
    (occupation entry : Nat → Real) (q : Real)
    (hrec : ∀ t, occupation (t + 1) = entry t + q * occupation t)
    (t : Nat) :
    occupation t = finiteOccupationRenewalSolution q (occupation 0) entry t := by
  induction t with
  | zero => rfl
  | succ t ih =>
      rw [hrec t, ih]
      rfl

end ECRuntime
